# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=insurance_db

# LLM Configuration
LLM_PROVIDER=ollama
LLM_MODEL=llama3.1

# Decisions with confidence_score (0-100) below this go to status 'needs_human_review'
CONFIDENCE_THRESHOLD=70

# MCP: how the agent reaches the MCP server that owns its tools (get_policy, check_coverage)
#  inmemory = in-process server over a linked in-memory transport (default)
#  stdio    = spawn the compiled server (dist/mcp/server.js) as a child process
MCP_TRANSPORT=inmemory
# Optional (stdio only): path to the compiled MCP server entry point
# MCP_SERVER_PATH=dist/mcp/server.js

# Optional: Direct database URL (used by CI)
# DATABASE_URL=postgresql://user:password@localhost:5432/insurance_db

# Optional: Langfuse tracing (enabled only when both keys are set)
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_BASEURL=https://cloud.langfuse.com

# PgAdmin Configuration
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=admin

# Use host.docker.internal if running Docker on Windows/Mac
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Authentication (required; the app refuses to start without these)
# Generate a strong secret, e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
# Token lifetime: seconds (e.g. 3600) or a duration such as 15m, 1h, 7d
JWT_EXPIRES_IN=1h
# Credentials accepted by POST /login
AUTH_USERNAME=change-me
AUTH_PASSWORD=change-me
